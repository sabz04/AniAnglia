<!--
    Colors.xaml
    Direct port of the Yukimo iOS palette (AniAnglia/Yukimo/DesignSystem/
    Theme/YukimoColor.swift). Coral primaries on warm-tinted surfaces;
    dark mode is warm grey, not flat black.

    Reference is hex of the iOS dyn(light:dark:) call. Same names; do
    not invent new ones without updating the iOS side.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===== LIGHT ===== -->
        <ResourceDictionary x:Key="Light">
            <!-- Brand -->
            <Color x:Key="YukimoPrimaryCoralColor">#FFFF6B66</Color>
            <Color x:Key="YukimoPrimaryCoralDarkColor">#FFF0525B</Color>
            <Color x:Key="YukimoPrimaryCoralLightColor">#FFFF9A96</Color>
            <Color x:Key="YukimoSoftPinkColor">#FFFFD8DD</Color>
            <Color x:Key="YukimoPalePinkColor">#FFFFF1F3</Color>

            <!-- Surfaces -->
            <Color x:Key="YukimoBackgroundColor">#FFFFF6F4</Color>
            <Color x:Key="YukimoSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="YukimoSurfaceElevatedColor">#FFFFF7F8</Color>
            <Color x:Key="YukimoSurfaceHighColor">#FFFFFDFC</Color>

            <!-- Text -->
            <Color x:Key="YukimoTextPrimaryColor">#FF2B1F24</Color>
            <Color x:Key="YukimoTextSecondaryColor">#FF7A5D65</Color>
            <Color x:Key="YukimoTextTertiaryColor">#FFB08A94</Color>
            <Color x:Key="YukimoTextOnPrimaryColor">#FFFFFFFF</Color>

            <!-- Border / divider -->
            <Color x:Key="YukimoBorderSoftColor">#2EFF6B66</Color>
            <Color x:Key="YukimoBorderStrongColor">#3D000000</Color>

            <!-- Accents -->
            <Color x:Key="YukimoAccentSkyColor">#FF5BB8FF</Color>
            <Color x:Key="YukimoAccentLavenderColor">#FFB497FF</Color>
            <Color x:Key="YukimoAccentMintColor">#FF5BD3B0</Color>

            <!-- Status -->
            <Color x:Key="YukimoSuccessColor">#FF3CC689</Color>
            <Color x:Key="YukimoWarningColor">#FFE69D2A</Color>
            <Color x:Key="YukimoDangerColor">#FFE5484D</Color>
        </ResourceDictionary>

        <!-- ===== DARK ===== -->
        <ResourceDictionary x:Key="Dark">
            <!-- Brand -->
            <Color x:Key="YukimoPrimaryCoralColor">#FFFF8580</Color>
            <Color x:Key="YukimoPrimaryCoralDarkColor">#FFF06E6B</Color>
            <Color x:Key="YukimoPrimaryCoralLightColor">#FFFFB0AB</Color>
            <Color x:Key="YukimoSoftPinkColor">#FF3A2A30</Color>
            <Color x:Key="YukimoPalePinkColor">#FF2A1B22</Color>

            <!-- Surfaces -->
            <Color x:Key="YukimoBackgroundColor">#FF171014</Color>
            <Color x:Key="YukimoSurfaceColor">#FF21171D</Color>
            <Color x:Key="YukimoSurfaceElevatedColor">#FF2B1E26</Color>
            <Color x:Key="YukimoSurfaceHighColor">#FF2B1E26</Color>

            <!-- Text -->
            <Color x:Key="YukimoTextPrimaryColor">#FFFFF4F6</Color>
            <Color x:Key="YukimoTextSecondaryColor">#FFD8B8C0</Color>
            <Color x:Key="YukimoTextTertiaryColor">#FFA98A92</Color>
            <Color x:Key="YukimoTextOnPrimaryColor">#FFFFFFFF</Color>

            <!-- Border / divider -->
            <Color x:Key="YukimoBorderSoftColor">#3DFF8580</Color>
            <Color x:Key="YukimoBorderStrongColor">#33FFFFFF</Color>

            <!-- Accents -->
            <Color x:Key="YukimoAccentSkyColor">#FF7BC4FF</Color>
            <Color x:Key="YukimoAccentLavenderColor">#FFC3ABFF</Color>
            <Color x:Key="YukimoAccentMintColor">#FF6FE0BD</Color>

            <!-- Status -->
            <Color x:Key="YukimoSuccessColor">#FF55D69B</Color>
            <Color x:Key="YukimoWarningColor">#FFFFB14C</Color>
            <Color x:Key="YukimoDangerColor">#FFFF6B72</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Reusable SolidColorBrushes — these pick up the active theme dict
         automatically because they reference *Color keys via ThemeResource. -->
    <SolidColorBrush x:Key="YukimoPrimaryCoralBrush"      Color="{ThemeResource YukimoPrimaryCoralColor}" />
    <SolidColorBrush x:Key="YukimoPrimaryCoralDarkBrush"  Color="{ThemeResource YukimoPrimaryCoralDarkColor}" />
    <SolidColorBrush x:Key="YukimoPrimaryCoralLightBrush" Color="{ThemeResource YukimoPrimaryCoralLightColor}" />
    <SolidColorBrush x:Key="YukimoSoftPinkBrush"          Color="{ThemeResource YukimoSoftPinkColor}" />
    <SolidColorBrush x:Key="YukimoPalePinkBrush"          Color="{ThemeResource YukimoPalePinkColor}" />

    <SolidColorBrush x:Key="YukimoBackgroundBrush"        Color="{ThemeResource YukimoBackgroundColor}" />
    <SolidColorBrush x:Key="YukimoSurfaceBrush"           Color="{ThemeResource YukimoSurfaceColor}" />
    <SolidColorBrush x:Key="YukimoSurfaceElevatedBrush"   Color="{ThemeResource YukimoSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="YukimoSurfaceHighBrush"       Color="{ThemeResource YukimoSurfaceHighColor}" />

    <SolidColorBrush x:Key="YukimoTextPrimaryBrush"       Color="{ThemeResource YukimoTextPrimaryColor}" />
    <SolidColorBrush x:Key="YukimoTextSecondaryBrush"     Color="{ThemeResource YukimoTextSecondaryColor}" />
    <SolidColorBrush x:Key="YukimoTextTertiaryBrush"      Color="{ThemeResource YukimoTextTertiaryColor}" />
    <SolidColorBrush x:Key="YukimoTextOnPrimaryBrush"     Color="{ThemeResource YukimoTextOnPrimaryColor}" />

    <SolidColorBrush x:Key="YukimoBorderSoftBrush"        Color="{ThemeResource YukimoBorderSoftColor}" />
    <SolidColorBrush x:Key="YukimoBorderStrongBrush"      Color="{ThemeResource YukimoBorderStrongColor}" />

    <SolidColorBrush x:Key="YukimoAccentSkyBrush"         Color="{ThemeResource YukimoAccentSkyColor}" />
    <SolidColorBrush x:Key="YukimoAccentLavenderBrush"    Color="{ThemeResource YukimoAccentLavenderColor}" />
    <SolidColorBrush x:Key="YukimoAccentMintBrush"        Color="{ThemeResource YukimoAccentMintColor}" />

    <SolidColorBrush x:Key="YukimoSuccessBrush"           Color="{ThemeResource YukimoSuccessColor}" />
    <SolidColorBrush x:Key="YukimoWarningBrush"           Color="{ThemeResource YukimoWarningColor}" />
    <SolidColorBrush x:Key="YukimoDangerBrush"            Color="{ThemeResource YukimoDangerColor}" />

    <!-- Override system accent — applies to Mica tint, focus rings, etc. -->
    <SolidColorBrush x:Key="SystemAccentColorBrush"       Color="{ThemeResource YukimoPrimaryCoralColor}" />

</ResourceDictionary>
