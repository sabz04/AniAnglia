<!--
    Tokens.xaml
    Spacing / radius / motion tokens. Direct port of YukimoSpacing.swift,
    YukimoRadius.swift and YukimoMotion.swift. Use ThemeResource to read.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Spacing (4-pt rhythm) ===== -->
    <x:Double x:Key="YukimoSpacingXxs">2</x:Double>
    <x:Double x:Key="YukimoSpacingXs">4</x:Double>
    <x:Double x:Key="YukimoSpacingSm">8</x:Double>
    <x:Double x:Key="YukimoSpacingMd">12</x:Double>
    <x:Double x:Key="YukimoSpacingLg">16</x:Double>
    <x:Double x:Key="YukimoSpacingXl">20</x:Double>
    <x:Double x:Key="YukimoSpacingXxl">24</x:Double>
    <x:Double x:Key="YukimoSpacingXxxl">32</x:Double>
    <x:Double x:Key="YukimoSpacingHuge">40</x:Double>
    <x:Double x:Key="YukimoSpacingMassive">56</x:Double>

    <x:Double x:Key="YukimoScreenPadding">20</x:Double>
    <x:Double x:Key="YukimoCardPadding">16</x:Double>

    <!-- ===== Radii ===== -->
    <CornerRadius x:Key="YukimoRadiusXs">8</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusSm">12</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusMd">16</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusLg">20</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusXl">24</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusXxl">28</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusPill">999</CornerRadius>

    <CornerRadius x:Key="YukimoRadiusCard">20</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusButton">16</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusField">16</CornerRadius>
    <CornerRadius x:Key="YukimoRadiusSheet">32</CornerRadius>

    <!-- ===== Durations (ms) — for use with x:Bind in code-behind ===== -->
    <x:Double x:Key="YukimoMotionFastMs">180</x:Double>
    <x:Double x:Key="YukimoMotionNormalMs">280</x:Double>
    <x:Double x:Key="YukimoMotionSlowMs">450</x:Double>

</ResourceDictionary>
