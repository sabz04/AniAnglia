<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AniAngliaWin.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:AniAngliaWin.Views"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid x:Name="ShellRoot">

        <!-- Drag region for the windowed title bar (extends-into-titlebar). -->
        <Grid x:Name="AppTitleBar"
              Height="40"
              VerticalAlignment="Top"
              Canvas.ZIndex="1"
              IsHitTestVisible="True"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>      <!-- back / system menu zone -->
                <ColumnDefinition Width="*"/>       <!-- title -->
                <ColumnDefinition Width="140"/>     <!-- caption buttons region -->
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="AppTitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       Style="{StaticResource YukimoSubhead}"
                       Foreground="{ThemeResource YukimoTextPrimaryBrush}"
                       Text="AniAnglia"/>
        </Grid>

        <!-- The main NavigationView shell. PaneDisplayMode=Auto adapts
             (Top → LeftCompact → Left) to the window width. -->
        <muxc:NavigationView
            x:Name="NavView"
            Margin="0,40,0,0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="220"
            CompactPaneLength="56"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Главная" Tag="home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Поиск" Tag="search">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Списки" Tag="library">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A4;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Лента" Tag="feed">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="Профиль" Tag="profile">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;"/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"
                   Padding="0"
                   IsNavigationStackEnabled="True"/>
        </muxc:NavigationView>

    </Grid>

</Page>
