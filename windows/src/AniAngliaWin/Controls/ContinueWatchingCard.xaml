<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniAngliaWin.Controls.ContinueWatchingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniAngliaWin.Controls"
    Width="320">

    <Border CornerRadius="{ThemeResource YukimoRadiusCard}"
            Background="{ThemeResource YukimoSurfaceBrush}"
            BorderBrush="{ThemeResource YukimoBorderSoftBrush}"
            BorderThickness="0.5">
        <Grid Padding="12" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 88×132 mini-poster (~2:3). -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="88" Height="132"
                    VerticalAlignment="Top"
                    CornerRadius="{ThemeResource YukimoRadiusSm}">
                <local:YukimoAsyncImage x:Name="Poster"
                                        Stretch="UniformToFill"/>
            </Border>

            <!-- Right column: title + episode -->
            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource YukimoBodyEmphasized}"
                           MaxLines="2"
                           TextWrapping="WrapWholeWords"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EpisodeText"
                           Style="{StaticResource YukimoFootnote}"
                           Foreground="{ThemeResource YukimoTextSecondaryBrush}"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <!-- Progress bar + percent label -->
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                <Grid Height="4">
                    <Rectangle Fill="{ThemeResource YukimoBorderSoftBrush}"
                               RadiusX="2" RadiusY="2"/>
                    <Rectangle x:Name="ProgressFill"
                               HorizontalAlignment="Left"
                               Width="0"
                               Fill="{ThemeResource YukimoPrimaryCoralBrush}"
                               RadiusX="2" RadiusY="2"/>
                </Grid>
                <TextBlock x:Name="PercentText"
                           Style="{StaticResource YukimoCaption}"
                           Foreground="{ThemeResource YukimoTextTertiaryBrush}"/>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
