<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniAngliaWin.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniAngliaWin.Controls"
    Width="160">

    <Grid RowSpacing="8" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- poster -->
            <RowDefinition Height="Auto"/> <!-- title -->
            <RowDefinition Height="Auto"/> <!-- meta -->
        </Grid.RowDefinitions>

        <!-- 2:3 poster — 160×240. Soft pink border, corner radius clips
             the YukimoAsyncImage inside via the Border itself. -->
        <Grid Grid.Row="0"
              Width="160" Height="240">
            <Border CornerRadius="{ThemeResource YukimoRadiusMd}"
                    BorderBrush="{ThemeResource YukimoBorderSoftBrush}"
                    BorderThickness="0.5">
                <local:YukimoAsyncImage x:Name="Poster"
                                        Stretch="UniformToFill"/>
            </Border>

            <!-- Status pill (overlay top-left). -->
            <Border x:Name="StatusPill"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="6,3"
                    CornerRadius="{ThemeResource YukimoRadiusPill}"
                    Background="#88000000"
                    Visibility="Collapsed">
                <TextBlock x:Name="StatusText"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="White"/>
            </Border>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="TitleText"
                   FontFamily="{StaticResource YukimoFontFamily}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource YukimoTextPrimaryBrush}"
                   MaxLines="2"
                   TextWrapping="WrapWholeWords"
                   TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6">
            <FontIcon Glyph="&#xE735;"
                      FontSize="10"
                      Foreground="{ThemeResource YukimoWarningBrush}"/>
            <TextBlock x:Name="GradeText"
                       FontFamily="{StaticResource YukimoFontFamily}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource YukimoTextPrimaryBrush}"/>
            <TextBlock x:Name="YearDot"
                       FontFamily="{StaticResource YukimoFontFamily}"
                       FontSize="11"
                       Foreground="{ThemeResource YukimoTextTertiaryBrush}"
                       Text=" · "/>
            <TextBlock x:Name="YearText"
                       FontFamily="{StaticResource YukimoFontFamily}"
                       FontSize="11"
                       Foreground="{ThemeResource YukimoTextSecondaryBrush}"/>
        </StackPanel>
    </Grid>

</UserControl>
