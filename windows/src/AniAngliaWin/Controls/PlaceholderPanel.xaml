<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniAngliaWin.Controls.PlaceholderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Coral halo + glyph -->
        <Grid Grid.Row="0"
              Width="120" Height="120"
              HorizontalAlignment="Center">
            <Ellipse Fill="{ThemeResource YukimoSoftPinkBrush}"/>
            <FontIcon x:Name="GlyphIcon"
                      FontSize="48"
                      Foreground="{ThemeResource YukimoPrimaryCoralBrush}"
                      Glyph="&#xE713;"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   x:Name="TitleText"
                   Style="{StaticResource YukimoTitle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Text="Скоро тут будет контент"/>

        <TextBlock Grid.Row="2"
                   x:Name="SubtitleText"
                   Style="{StaticResource YukimoFootnote}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="360"
                   TextWrapping="Wrap"
                   Foreground="{ThemeResource YukimoTextSecondaryBrush}"/>
    </Grid>

</UserControl>
