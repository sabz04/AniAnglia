<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniAngliaWin.Controls.Shimmer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid x:Name="Root" Background="{ThemeResource YukimoSoftPinkBrush}">
        <!-- Linear gradient that slides left → right gives the shimmer. -->
        <Rectangle x:Name="HighlightRect" Opacity="0.45">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="HighlightBrush"
                                     StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="Transparent" Offset="0.0"/>
                    <GradientStop Color="White"       Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="HighlightTransform" X="-400"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>

</UserControl>
