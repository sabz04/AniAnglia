<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AniAngliaWin.Controls.YukimoAsyncImage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AniAngliaWin.Controls">

    <Grid>
        <!-- Shimmer placeholder while the image hasn't decoded. -->
        <local:Shimmer x:Name="Placeholder"/>

        <Image x:Name="HostedImage"
               Stretch="UniformToFill"
               Opacity="0"
               ImageOpened="OnImageOpened"
               ImageFailed="OnImageFailed"/>
    </Grid>

</UserControl>
